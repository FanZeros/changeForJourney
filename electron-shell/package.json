{
  "name": "zhongyan-zhimen-win64-offline",
  "productName": "ZhongYanZhiMen",
  "version": "1.0.4",
  "description": "终焉之门·单机版 Windows 离线版（Electron 壳，免登录双击即玩）",
  "author": "FanZeros",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64",
    "dir": "electron-builder --win --dir --x64"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.fanzeros.zyjm",
    "productName": "ZhongYanZhiMen",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "game",
        "to": "game"
      }
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "ZhongYanZhiMen-win64-offline-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ZhongYanZhiMen-win64-setup-${version}.exe"
    }
  }
}
